---
import type { CollectionEntry } from 'astro:content'
import { useTranslations } from '@/i18n'

export interface Props {
  data: CollectionEntry<'research'>['data']
  locale?: string
}

const { data, locale: localeProp } = Astro.props
const locale = localeProp ?? Astro.currentLocale ?? 'en'
const t = useTranslations(locale)
---

<footer class="research-attribution nested-card" aria-label={t('research.attributionRegionLabel')}>
  <p class="ra-line">
    {t('research.attributionBy')}{' '}
    {data.authorUrl ? (
      <a class="ra-link" href={data.authorUrl} target="_blank" rel="noopener noreferrer">
        {data.author}
        <span class="ra-visually-hidden">({t('research.externalNewTab')})</span>
      </a>
    ) : (
      <span class="ra-strong">{data.author}</span>
    )}
  </p>

  <p class="ra-line">
    {t('research.publishedBy')} <span class="ra-strong">{data.publisher}</span> · {data.year}
  </p>

  <p class="ra-line">
    {t('research.licenseLabel')}{' '}
    <a class="ra-link" href={data.licenseUrl} target="_blank" rel="noopener noreferrer">
      {data.license}
      <span class="ra-visually-hidden">({t('research.externalNewTab')})</span>
    </a>
  </p>

  <p class="ra-note">
    {t('research.importedOnLabel')} {data.importedOn}. {t('research.noAutoUpdate')}
  </p>

  {locale !== 'en' && <p class="ra-locale">{t('research.localeNotice')}</p>}
</footer>

<style>
  .research-attribution {
    margin-top: 3rem;
  }

  .ra-line {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-brand-text);
    margin: 0 0 0.375rem 0;
  }

  .ra-strong {
    font-weight: 600;
    color: var(--color-brand-text);
  }

  .ra-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
    color: var(--color-brand-primary);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease;
  }

  .ra-link:hover {
    border-bottom-color: var(--color-brand-primary);
  }

  .ra-link:focus-visible {
    outline: 2px solid var(--color-focus-ring);
    outline-offset: 2px;
    border-radius: 2px;
  }

  .ra-note {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-brand-text);
    opacity: 0.75;
    margin: 0.75rem 0 0 0;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-card-border);
  }

  .ra-locale {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-brand-primary);
    margin: 0.625rem 0 0 0;
  }

  .ra-visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
