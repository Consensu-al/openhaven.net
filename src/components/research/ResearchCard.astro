---
import { useTranslations } from '@/i18n'

export interface Props {
  href: string
  title: string
  summary?: string
  external?: boolean
  locale?: string
  // Optional BCP-47 lang for the (English) title + summary on pt-BR pages (FR34).
  contentLang?: string
  // Optional override for the external CTA text (defaults to "View diagram").
  ctaLabel?: string
}

const { href, title, summary, external = false, locale: localeProp, contentLang, ctaLabel } = Astro.props
const locale = localeProp ?? Astro.currentLocale ?? 'en'
const t = useTranslations(locale)
const externalCta = ctaLabel ?? (t('research.viewDiagram') as string)
---

<article class="research-card nested-card">
  <h3 class="research-card-title" lang={contentLang}>{title}</h3>
  {summary && <p class="research-card-summary" lang={contentLang}>{summary}</p>}

  {external ? (
    <a
      class="research-card-cta"
      href={href}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`${externalCta}: ${title} (${t('research.externalNewTab')})`}
    >
      <span>{externalCta}</span>
      <svg class="research-card-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M7 7h10v10" />
        <path d="M7 17 17 7" />
      </svg>
      <span class="research-card-vh">({t('research.externalNewTab')})</span>
    </a>
  ) : (
    <a class="research-card-cta" href={href} aria-label={`${t('research.readReport')}: ${title}`}>
      <span>{t('research.readReport')}</span>
      <svg class="research-card-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 12h14" />
        <path d="m12 5 7 7-7 7" />
      </svg>
    </a>
  )}
</article>

<style>
  .research-card {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .research-card-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-brand-primary);
    margin: 0 0 0.5rem 0;
    line-height: 1.3;
  }

  .research-card-summary {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-brand-text);
    margin: 0 0 1rem 0;
    flex: 1;
  }

  .research-card-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    align-self: flex-start;
    min-height: 44px;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-brand-primary);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease;
  }

  .research-card-cta:hover {
    border-bottom-color: var(--color-brand-primary);
  }

  .research-card-cta:focus-visible {
    outline: 2px solid var(--color-focus-ring);
    outline-offset: 2px;
    border-radius: 2px;
  }

  .research-card-icon {
    flex-shrink: 0;
  }

  .research-card-vh {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
