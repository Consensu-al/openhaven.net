---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from '@/components/ui/PageHeader.astro';
import { useTranslations } from '@/i18n';

const locale = 'pt-BR';
const t = useTranslations(locale);
const prefix = '/pt-BR';
---

<BaseLayout
  title={t('brief.title') as string}
  description={t('brief.description') as string}
>
  <main class="brief-page">
    <section class="section-padding">
      <div class="container">
        <PageHeader
          title={t('brief.heading') as string}
          breadcrumbLabel={t('nav.brief') as string}
          locale={locale}
        />
      </div>
    </section>

    <section class="section-padding brief-section">
      <div class="container">
        <h2>{t('brief.executiveSummary')}</h2>
        <p>{t('brief.executiveSummaryP1')}</p>
        <p set:html={t('brief.executiveSummaryP2')} />
        <p set:html={t('brief.executiveSummaryP3')} />
      </div>
    </section>

    <section class="section-padding brief-section">
      <div class="container">
        <h2>{t('brief.coreVision')}</h2>

        <h3>{t('brief.problemStatement')}</h3>
        <p>{t('brief.problemStatementBody')}</p>
        <ul class="brief-list">
          {(t('brief.problemList') as string[]).map((item) => (
            <li set:html={item} />
          ))}
        </ul>

        <h3>{t('brief.problemImpact')}</h3>
        <p>{t('brief.problemImpactBody')}</p>

        <h3>{t('brief.whyExistingFail')}</h3>
        <p>{t('brief.whyExistingFailIntro')}</p>
        <ul class="brief-list">
          {(t('brief.whyExistingFailList') as string[]).map((item) => (
            <li set:html={item} />
          ))}
        </ul>

        <h3>{t('brief.proposedSolution')}</h3>
        <p>{t('brief.proposedSolutionIntro')}</p>
        <ol class="brief-list brief-list--ordered">
          {(t('brief.proposedSolutionList') as string[]).map((item) => (
            <li set:html={item} />
          ))}
        </ol>
        <p>{t('brief.proposedSolutionFooter')}</p>

        <h3>{t('brief.keyDifferentiators')}</h3>
        <ul class="brief-list">
          {(t('brief.keyDifferentiatorsList') as string[]).map((item) => (
            <li set:html={item} />
          ))}
        </ul>

        <h3>{t('brief.ecosystemContext')}</h3>
        <p>{t('brief.ecosystemContextBody')}</p>
      </div>
    </section>

    <section class="section-padding brief-section">
      <div class="container">
        <h2>{t('brief.whoItsFor')}</h2>
        <p>{t('brief.whoItsForIntro')}</p>

        <div class="persona">
          <p set:html={t('brief.personas.mira')} />
        </div>
        <div class="persona">
          <p set:html={t('brief.personas.raul')} />
        </div>
        <div class="persona">
          <p set:html={t('brief.personas.jess')} />
        </div>
        <div class="persona">
          <p set:html={t('brief.personas.amara')} />
        </div>
      </div>
    </section>

    <section class="section-padding brief-section brief-section--last">
      <div class="container">
        <h2>{t('brief.successHeading')}</h2>
        <ul class="brief-list">
          {(t('brief.successMetrics') as string[]).map((item) => (
            <li set:html={item} />
          ))}
        </ul>
      </div>
    </section>

    <section class="section-padding">
      <div class="container">
        <div class="cta-section">
          <h2>{t('brief.getInTouch')}</h2>
          <p set:html={t('brief.getInTouchBody')} />
        </div>

        <div class="brief-attribution">
          <p class="brief-meta">{t('brief.attribution')}</p>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .brief-section {
    border-bottom: 1px solid rgba(139, 69, 19, 0.1);
  }

  .brief-section--last {
    border-bottom: none;
  }

  .brief-section h2 {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-brand-primary);
    margin: 0 0 1.25rem 0;
  }

  .brief-section h3 {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-brand-primary);
    margin: 2rem 0 0.75rem 0;
  }

  .brief-section h3:first-of-type {
    margin-top: 0;
  }

  .brief-section p {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-brand-text);
    max-width: 75ch;
    margin: 0 0 1rem 0;
  }

  .brief-meta {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-brand-text);
    opacity: 0.7;
    margin: 0;
    font-style: italic;
  }

  .brief-list {
    list-style: none;
    padding: 0;
    margin: 0 0 1.25rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .brief-list li {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-brand-text);
    padding-left: 1.5rem;
    position: relative;
  }

  .brief-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-brand-accent);
  }

  .brief-list--ordered {
    counter-reset: brief-counter;
  }

  .brief-list--ordered li {
    counter-increment: brief-counter;
    padding-left: 2rem;
  }

  .brief-list--ordered li::before {
    content: counter(brief-counter) '.';
    width: auto;
    height: auto;
    border-radius: 0;
    background: none;
    font-weight: 600;
    color: var(--color-brand-primary);
    font-size: 0.9375rem;
    top: 0;
  }

  .persona {
    background: rgba(139, 69, 19, 0.03);
    border-left: 3px solid var(--color-brand-accent);
    padding: 1.25rem 1.5rem;
    margin-bottom: 1rem;
    border-radius: 0 0.375rem 0.375rem 0;
  }

  .persona p {
    margin: 0;
  }

  .cta-section {
    background: var(--color-brand-accent-light);
    border-left: 4px solid var(--color-brand-accent);
    border-radius: 0 0.5rem 0.5rem 0;
    padding: 2rem 2.5rem;
    text-align: center;
  }

  .cta-section h2 {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-brand-primary);
    margin: 0 0 0.75rem 0;
  }

  .cta-section p {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-brand-text);
    margin: 0;
    max-width: none;
  }

  .brief-attribution {
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(139, 69, 19, 0.1);
  }

  code {
    font-family: var(--font-mono);
    font-size: 0.875em;
    background: rgba(139, 69, 19, 0.06);
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
  }
</style>
