---
import BaseLayout from '@/layouts/BaseLayout.astro'
import PageHeader from '@/components/ui/PageHeader.astro'
import { useTranslations } from '@/i18n'

const locale = Astro.currentLocale ?? 'pt-BR'
const t = useTranslations(locale)

const FORM_URL = 'https://cryptpad.fr/form/#/2/form/view/xChgBL3ouQRbBqOdEkwt0W+sWc7XFcDV1EpZby1c6Hs/'
const FORM_EMBED_URL = 'https://cryptpad.fr/form/#/2/form/view/xChgBL3ouQRbBqOdEkwt0W+sWc7XFcDV1EpZby1c6Hs/embed/'
---

<BaseLayout
  title={t('contribute.pageTitle') as string}
  description={t('contribute.pageDescription') as string}
>
  <main data-testid="contribute-page">
    <section class="section-padding">
      <div class="container">
        <PageHeader
          title={t('contribute.heading') as string}
          breadcrumbLabel={t('nav.contribute') as string}
          locale={locale}
        />
      </div>
    </section>

    <section class="section-padding">
      <div class="container">
        <h2 class="section-heading">Sobre contribuir</h2>
        <p class="body-text">{t('contribute.intro1')}</p>
        <p class="body-text">{t('contribute.intro2')}</p>
        <p class="body-text cross-link" set:html={t('contribute.contactNote')} />
      </div>
    </section>

    <section class="section-padding">
      <div class="container">
        <h2 class="section-heading">Envie uma contribuição</h2>
        <p class="form-note">
          {t('contribute.formNote')}{' '}
          <a
            href={FORM_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="form-link"
          >
            {t('contribute.formLinkText')}
          </a>
        </p>

        <div class="iframe-wrapper">
          <iframe
            src={FORM_EMBED_URL}
            title={t('contribute.iframeTitle') as string}
            style="width: 100%; height: 700px; border: none; display: block;"
          ></iframe>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .cross-link {
    font-size: 0.9375rem;
    color: var(--color-brand-text);
    margin: 0;
    opacity: 0.85;
  }

  .cross-link :global(a) {
    color: var(--color-brand-primary);
    text-decoration: underline;
    font-weight: 500;
  }

  .form-note {
    font-size: 0.9375rem;
    color: var(--color-brand-text);
    margin: 0 0 1rem 0;
  }

  .form-link {
    color: var(--color-brand-primary);
    text-decoration: underline;
    font-weight: 500;
  }

  .form-link:hover {
    opacity: 0.8;
  }

  .iframe-wrapper {
    background: white;
    border: 2px solid rgba(139, 69, 19, 0.25);
    border-radius: 1rem;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
  }
</style>
