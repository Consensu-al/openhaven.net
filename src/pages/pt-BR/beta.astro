---
import BaseLayout from '@/layouts/BaseLayout.astro'
import PageHeader from '@/components/ui/PageHeader.astro'
import { useTranslations } from '@/i18n'

const locale = 'pt-BR'
const t = useTranslations(locale)
const prefix = '/pt-BR'
---

<BaseLayout
  title={t('beta.pageTitle') as string}
  description={t('beta.pageDescription') as string}
>
  <main data-testid="beta-page">
    <section class="section-padding">
      <div class="container">
        <PageHeader
          title={t('beta.heading') as string}
          subtitle={t('beta.subtitle') as string}
          breadcrumbLabel={t('nav.beta') as string}
          locale={locale}
        />
      </div>
    </section>

    <section class="section-padding section-alt">
      <div class="container">
        <div class="status-grid">
          <div class="status-card">
            <h2 class="card-heading">{t('beta.statusHeading')}</h2>
            <p class="card-body">{t('beta.statusBody')}</p>
            <a href={`${prefix}/prototype`} class="cta-link">{t('beta.navigatorLink')}</a>
          </div>

          <div class="status-card">
            <h2 class="card-heading">{t('beta.dataHeading')}</h2>
            <p class="card-body">{t('beta.dataBody')}</p>
            <a href={`${prefix}/prototype/matrix`} class="cta-link">{t('beta.matrixLink')}</a>
          </div>

          <div class="status-card">
            <h2 class="card-heading">{t('beta.contributionHeading')}</h2>
            <p class="card-body">{t('beta.contributionBody')}</p>
            <a href={`${prefix}/contribute`} class="cta-link">{t('beta.contributeLink')}</a>
          </div>

          <div class="status-card">
            <h2 class="card-heading">{t('beta.verificationHeading')}</h2>
            <p class="card-body">{t('beta.verificationBody')}</p>
            <a href={`${prefix}/process`} class="cta-link">{t('beta.processLink')}</a>
          </div>
        </div>
      </div>
    </section>

    <section class="section-padding">
      <div class="container">
        <h2 class="involve-heading">{t('beta.getInvolved')}</h2>
        <p class="involve-body">{t('beta.getInvolvedBody')}</p>

        <div class="link-group">
          <a href={`${prefix}/contribute`} class="cta-link">{t('beta.contributeLink')}</a>
          <a href={`${prefix}/process`} class="cta-link">{t('beta.processLink')}</a>
          <a href={`${prefix}/contact`} class="cta-link">{t('beta.contactLink')}</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .status-grid {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .status-card {
    background: white;
    border: 1px solid rgba(139, 69, 19, 0.15);
    border-radius: 0.75rem;
    padding: 1.25rem;
  }

  @media (min-width: 640px) {
    .status-card {
      padding: 1.5rem;
    }
  }

  .card-heading {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-brand-primary);
    margin: 0 0 0.5rem 0;
    line-height: 1.3;
  }

  .card-body {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-brand-text);
    margin: 0 0 0.75rem 0;
  }

  .involve-heading {
    font-size: 1.375rem;
    font-weight: 700;
    color: var(--color-brand-primary);
    margin: 0 0 0.75rem 0;
    line-height: 1.3;
  }

  .involve-body {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-brand-text);
    margin: 0 0 1.5rem 0;
    max-width: 75ch;
  }

  .link-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  @media (min-width: 640px) {
    .link-group {
      flex-direction: row;
      gap: 1.5rem;
    }
  }

  .cta-link {
    display: inline-flex;
    align-items: center;
    padding: 0.375rem 0;
    min-height: 44px;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-brand-primary);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease;
  }

  .cta-link:hover {
    border-bottom-color: var(--color-brand-primary);
  }

  .cta-link:focus-visible {
    outline: 2px solid var(--color-focus-ring);
    outline-offset: 2px;
    border-radius: 2px;
  }
</style>
